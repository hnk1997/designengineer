# Cloudflare Pages headers.

# Every page: basic hardening. No third-party scripts, frames or trackers run on this site.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# The 3D library and font files carry their version in their path or name, so browsers can
# keep them for a year without asking again.
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Reels, posters, logos and device frames keep their names when they're re-cut, so: a day
# fresh, then served from cache while the browser checks for a newer one in the background
/assets/work/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/building/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/devices/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The build tooling isn't part of the site
/scripts/*
  X-Robots-Tag: noindex

/assets/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
